# ── Database (Turso / libSQL) ─────────────────────────────────
# Production: Turso cloud. Local dev fallback: file:./db/custom.db
TURSO_DATABASE_URL=libsql://your-db-youruser.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Used by Prisma CLI for local schema push (not used at runtime when Turso is set)
DATABASE_URL=file:./db/custom.db

# ── Auth ──────────────────────────────────────────────────────
AUTH_SECRET=change-me-to-a-long-random-string
