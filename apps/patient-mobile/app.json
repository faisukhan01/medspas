{
  "expo": {
    "name": "Auralis",
    "slug": "auralis-patient",
    "scheme": "auralis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#fafaf9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auralis.patient"
    },
    "android": {
      "package": "com.auralis.patient",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
